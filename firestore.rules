rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      // Use the personId which should match the auth UID
      return get(/databases/$(database)/documents/people/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return role in getUserData().roles;
    }

    function isSystemArchitect() {
      return hasRole('System Architect');
    }
    
    function isAdmin() {
      return hasRole('Admin') || isSystemArchitect();
    }
    
    function isSportsmaster() {
      return hasRole('Sportsmaster');
    }
    
    function canManageData() {
        return isAdmin() || isSportsmaster();
    }
    
    // People: Users can read/update their own profile. Admins can read/write any.
    match /people/{personId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // User creation is handled by a server action, but allow for signup.
      allow update: if isOwner(personId) || canManageData();
      allow delete: if isAdmin();
    }
    
    // Core Data: Schools, Divisions, Seasons, Fields are managed by Admins/Sportsmasters.
    // Read access is generally open to any authenticated user.
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }
    
    match /divisions/{divisionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }
    
    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }
    
    match /fields/{fieldId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
      
      // Groundskeeper assignments on fields
      match /assignments/{assignmentId} {
        allow read, create, delete: if canManageData();
      }
    }
    
    // Competitions & Teams
    match /competitions/{competitionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }
    
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
      
      match /roster/{rosterId} {
        allow read: if isSignedIn();
        allow create, update, delete: if canManageData();
      }
    }
    
    // Matches
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create, delete: if canManageData();
      // Updates are more complex, handled by specific actions, but a general rule is useful.
      // E.g., a Coach can update a lineup, an Umpire can update a score.
      allow update: if isSignedIn();
      
      // Officials can confirm their own assignment.
      match /officials/{officialId} {
        allow read: if isSignedIn();
        allow create, delete: if canManageData();
        allow update: if canManageData() || isOwner(get(/databases/$(database)/documents/matches/$(matchId)/officials/$(officialId)).data.personId);
      }
      
      match /lineups/{teamId} {
        allow read, create, update: if isSignedIn();
      }

      match /scorecards/{innings} {
         allow read: if isSignedIn();
         allow create, update, delete: if hasRole('Scorer') || hasRole('Umpire') || canManageData();
      }

      match /transportAssignments/{assignmentId} {
        allow read, create, delete: if canManageData();
      }
    }
    
    // Other top-level collections
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }
    
    match /familyLinks/{linkId} {
        allow read, create, delete: if isSignedIn();
    }
    
    match /financials/{transactionId} {
        allow read, create, update, delete: if canManageData();
    }
    
    match /equipment/{itemId} {
        allow read, create, update, delete: if canManageData();
    }
    
    match /equipmentAssignments/{assignmentId} {
        allow read, create, update, delete: if canManageData();
    }
    
    match /sponsors/{sponsorId} {
        allow read, create, update, delete: if canManageData();
    }
    
    match /drills/{drillId} {
        allow read: if isSignedIn();
        allow create, update, delete: if hasRole('Coach') || canManageData();
    }

    match /sessions/{sessionId} {
        allow read: if isSignedIn();
        allow create, update, delete: if hasRole('Coach') || canManageData();
    }
    
    match /assignmentRequests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if canManageData(); // Only admins/sportsmasters can approve/deny
    }
    
    match /auditLogs/{logId} {
        allow read: if canManageData();
        allow create: if isSignedIn(); // Logged by server actions
    }
  }
}
